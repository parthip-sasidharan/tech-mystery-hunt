# ─── Tech Mystery Hunt – The Missing Code ────────────────────────────────────
# Copy this file to .env and fill in real values before running.

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (or local MongoDB):
#   MongoDB Atlas format:
#   MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tech_mystery_hunt?retryWrites=true&w=majority"
#   Local MongoDB format:
MONGODB_URI="mongodb://127.0.0.1:27017/tech_mystery_hunt"

# Legacy fallback (SQLite preserved during migration):
DATABASE_URL="file:./dev.db"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Minimum 64-character random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-very-long-random-string-for-production"

# ── First-Run Admin Bootstrap ─────────────────────────────────────────────────
# Used ONLY by scripts/setup-admin.js on first run.
# Remove or leave blank after the admin account is created.
ADMIN_SETUP_USERNAME="admin"
ADMIN_SETUP_EMAIL="admin@techfest.college.edu"
ADMIN_SETUP_NAME="Grand Master Admin"
# ADMIN_SETUP_PASSWORD is intentionally omitted from this file.
# Provide it on the command line:
#   ADMIN_SETUP_PASSWORD="YourSecurePass" node scripts/setup-admin.js

# ── Event Configuration ────────────────────────────────────────────────────────
# These are database-level defaults written by the seed / setup script.
# Change them at runtime via the Admin Dashboard (stored in GameConfig table).
DEFAULT_CHECKPOINT_COUNT="8"    # 8 or 10
TOTAL_TREASURE_BOXES="3"
HINT_THRESHOLD="2"              # Number of wrong attempts before hint is revealed

# ── Node Environment ───────────────────────────────────────────────────────────
NODE_ENV="development"
