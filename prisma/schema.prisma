generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Global System and Event Configuration ────────────────────────────────────
model GameConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([key])
}

// ─── Admins & Volunteers ──────────────────────────────────────────────────────
// role: "ADMIN" (full event management) | "VOLUNTEER" (task verification & prize confirmation only)
// Volunteers are scoped to specific assigned checkpoints via assignedCheckpointId.
model User {
  id                   String             @id @default(cuid())
  username             String             @unique
  email                String             @unique
  passwordHash         String
  name                 String
  role                 String             @default("VOLUNTEER")
  active               Boolean            @default(true)
  assignedCheckpointId String?            // Volunteer station assignment (null = roving)
  verifiedClaims       PrizeClaim[]
  taskVerifications    TaskVerification[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([role])
  @@index([active])
}

// ─── Team Registrations (pre-approval record) ─────────────────────────────────
// Captures every application attempt. Default mode: auto-approve.
// If admin sets REGISTRATION_APPROVAL=manual, new registrations wait in PENDING.
model Registration {
  id            String   @id @default(cuid())
  teamName      String   @unique
  leaderName    String
  leaderEmail   String   @unique
  leaderPhone   String
  membersJson   String   // JSON array of [{ name, collegeId, phone }]
  passwordHash  String
  status        String   @default("APPROVED") // "PENDING" | "APPROVED" | "REJECTED"
  rejectionNote String?
  approvedTeamId String? @unique             // Links to Team.id once approved
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([leaderEmail])
}

// ─── Registered Teams ─────────────────────────────────────────────────────────
model Team {
  id                     String         @id @default(cuid())
  teamId                 String         @unique  // Auto-generated e.g. "MH-2026-001"
  name                   String         @unique
  leaderName             String
  leaderEmail            String         @unique
  leaderPhone            String
  members                String         // JSON array of [{ name, collegeId, phone }]
  passwordHash           String
  routeId                String?
  route                  Route?         @relation(fields: [routeId], references: [id])
  status                 String         @default("WAITING")
  // "REGISTERED" | "WAITING" | "IN_PROGRESS" | "COMPLETED" | "DISQUALIFIED"
  currentCheckpointIndex Int            @default(0)
  currentStage           String         @default("WAITING_ROOM")
  // "WAITING_ROOM" | "HUNTING" | "TREASURE_SEARCH" | "FINISHED"
  startedAt              DateTime?
  completedAt            DateTime?
  progress               TeamProgress[]
  prizeClaim             PrizeClaim?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([status])
  @@index([currentStage])
  @@index([routeId])
  @@index([leaderEmail])
}

// ─── Campus Routes (anti-crowding dispersal) ──────────────────────────────────
model Route {
  id                 String   @id @default(cuid())
  name               String   @unique
  description        String?
  checkpointSequence String   // JSON array of sequenceNumbers e.g. [1,3,5,7,2,4,6,8]
  active             Boolean  @default(true)
  teams              Team[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([active])
}

// ─── Physical Checkpoints ─────────────────────────────────────────────────────
model Checkpoint {
  id                String             @id @default(cuid())
  sequenceNumber    Int                @unique
  name              String
  locationHint      String             // Client-visible clue for physical navigation
  campusArea        String
  qrCodeToken       String             @unique  // NEVER returned in team-facing API responses
  isFinalTreasure   Boolean            @default(false)
  treasureBoxNumber Int?
  questions         Question[]
  teamProgress      TeamProgress[]
  taskVerifications TaskVerification[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([sequenceNumber])
  @@index([isFinalTreasure])
}

// ─── Questions / Riddles at Checkpoints ───────────────────────────────────────
model Question {
  id                String     @id @default(cuid())
  checkpointId      String
  checkpoint        Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  prompt            String
  type              String     @default("MULTIPLE_CHOICE")
  // "MULTIPLE_CHOICE" | "TEXT_CODE" | "NUMERIC" | "BOX_SELECTION"
  options           String?    // JSON array of strings (for MULTIPLE_CHOICE)
  correctAnswerHash String     // bcrypt hash – NEVER included in any API response
  points            Int        @default(100)
  hint              String?    // Revealed only after attemptsCount >= HINT_THRESHOLD
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([checkpointId])
}

// ─── Checkpoint Progress per Team ─────────────────────────────────────────────
model TeamProgress {
  id               String     @id @default(cuid())
  teamId           String
  team             Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  checkpointId     String
  checkpoint       Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  scannedAt        DateTime?
  qrValidated      Boolean    @default(false)
  answerSubmitted  String?    // Last submitted answer text only (not correct answer)
  isAnswerCorrect  Boolean    @default(false)
  attemptsCount    Int        @default(0)
  completedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([teamId, checkpointId])
  @@index([teamId])
  @@index([checkpointId])
  @@index([isAnswerCorrect])
}

// ─── Volunteer Task Verification ──────────────────────────────────────────────
// On-ground volunteer actions at physical checkpoints (e.g., confirm presence, log violations).
model TaskVerification {
  id           String     @id @default(cuid())
  checkpointId String
  checkpoint   Checkpoint @relation(fields: [checkpointId], references: [id])
  volunteerId  String
  volunteer    User       @relation(fields: [volunteerId], references: [id])
  teamId       String     // Which team is being verified
  action       String
  // "PRESENCE_CONFIRMED" | "RULE_VIOLATION" | "CHECKPOINT_STAFFED" | "EMERGENCY_BYPASS"
  notes        String?
  verifiedAt   DateTime   @default(now())
  createdAt    DateTime   @default(now())

  @@index([checkpointId])
  @@index([volunteerId])
  @@index([teamId])
}

// ─── Physical Treasure Box Claims ─────────────────────────────────────────────
model PrizeClaim {
  id             String    @id @default(cuid())
  teamId         String    @unique
  team           Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  boxNumber      Int
  claimCode      String    @unique  // One-time token presented to volunteer at prize dais
  status         String    @default("PENDING_VERIFICATION")
  // "PENDING_VERIFICATION" | "CONFIRMED" | "REJECTED"
  claimedAt      DateTime  @default(now())
  volunteerId    String?
  volunteer      User?     @relation(fields: [volunteerId], references: [id])
  volunteerNotes String?
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([volunteerId])
}

// ─── Immutable Audit Log ───────────────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actorRole String
  actorId   String?
  details   String?  // JSON-encoded extra data
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([actorRole])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}
